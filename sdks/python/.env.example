# Live-test credentials for motosan-ai Python SDK integration tests.
#
# Copy this file to `.env` (gitignored) and fill in real keys:
#     cp sdks/python/.env.example sdks/python/.env
#
# Load into your shell before running live tests:
#     set -a && source sdks/python/.env && set +a
#     cd sdks/python && uv run pytest tests/integration/ -v

# Anthropic — https://console.anthropic.com/settings/keys
# Accepts standard `sk-ant-api03-*` keys or `sk-ant-oat01-*` OAuth setup tokens.
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# MiniMax — https://platform.minimaxi.com
MINIMAX_API_KEY=
